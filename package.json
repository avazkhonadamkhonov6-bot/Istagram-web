{
  "name": "instagram-clone",
  "private": true,
  "scripts": {
    "dev": "npx --yes pnpm@10.34.7 --filter @repo/shared build && npx --yes pnpm@10.34.7 --filter web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "start": "pnpm --filter api db:deploy && pnpm --filter api start:render",
    "dev:all": "npx --yes pnpm@10.34.7 exec turbo run dev",
    "check:api": "node scripts/check-backend.mjs"
  },
  "devDependencies": {
    "turbo": "^2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@nestjs/core", "@prisma/client", "@prisma/engines", "argon2", "prisma", "sharp", "unrs-resolver"]
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.7+sha512.ba98abc585539933375b5971f4bc6d6c73a1b4b7edc4a879e7d102fe5423d1e02309d67c60a11f04955093a96e521ad9c3b138cdd654ca5be563f378b3ae48bd"
}
