# NestJS API (faqat server-i Next — BFF)
# Bazai umumi (Avaz + Abubakr) dar Render: https://istagram-web.onrender.com
# API-i lokali: http://localhost:4000
API_URL=https://istagram-web.onrender.com
# Socket.IO (brauzer mustaqim, bo ws-ticket-i 60 s) — hamon URL
NEXT_PUBLIC_WS_URL=https://istagram-web.onrender.com
# on — MSW mock (cookie tekshirida nameshavad), off — API-i voqe'i
NEXT_PUBLIC_API_MOCKING=off
# Suroghai umumii sayt baroi SEO (canonical, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
