NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/instagram
# >= 32 aloma
JWT_SECRET=change_me_change_me_change_me_change_me
JWT_EXPIRES_IN=7d
# papkai faylho (aks/video), dastras dar /images/<fileName>
UPLOAD_DIR=uploads
PUBLIC_URL=http://localhost:4000
# Zang va efir (Spec 16): STUN-i ozod; TURN — ixtiyori, baroi shabakahoi mahdud (bo vergul)
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
