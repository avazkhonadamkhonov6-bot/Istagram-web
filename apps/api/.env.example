NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/instagram
# >= 32 aloma
JWT_SECRET=change_me_change_me_change_me_change_me
JWT_EXPIRES_IN=7d
# papkai faylho (aks/video), dastras dar /images/<fileName>
UPLOAD_DIR=uploads
PUBLIC_URL=http://localhost:4000
# Zang va efir (Spec 16): STUN-i ozod; TURN — ixtiyori, baroi shabakahoi mahdud (bo vergul)
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Kodi ivazi parol ba e-mail (ixtiyori) — qadam ba qadam: docs/EMAIL.md
# Sanjish: pnpm --filter api mail:test you@gmail.com
# 1) Gmail (lokali): Google Account -> Security -> 2-Step Verification -> App passwords
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# 2) Brevo (HTTP; dar Render free ham kor mekunad): brevo.com -> SMTP & API -> API keys
# BREVO_API_KEY=
# MAIL_FROM=Instagram <you@gmail.com>
# 3) SMTP-i digar yo Resend:
# SMTP_URL=smtps://you%40gmail.com:app-password@smtp.gmail.com:465
# RESEND_API_KEY=
