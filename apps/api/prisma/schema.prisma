// Modeli DB (Spec 12). ID-i user — uuid, digaron — integer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  userName       String   @unique // hamesha lowercase
  email          String   @unique // hamesha lowercase
  fullName       String?
  passwordHash   String
  avatar         String? // nomi fayl dar UPLOAD_DIR
  about          String?  @db.VarChar(150)
  gender         Int?
  postsCount     Int      @default(0)
  followersCount Int      @default(0)
  followingCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  resetTokens     PasswordResetToken[]
  posts           Post[]
  likes           PostLike[]
  views           PostView[]
  comments        PostComment[]
  favorites       PostFavorite[]
  followers       Follow[]             @relation("following")
  following       Follow[]             @relation("follower")
  stories         Story[]
  storyViews      StoryView[]
  storyLikes      StoryLike[]
  sentChats       Chat[]               @relation("sendUser")
  receivedChats   Chat[]               @relation("receiveUser")
  messages        Message[]
  searchHistories SearchHistory[]
  userSearches    UserSearchHistory[]  @relation("searcher")
  searchedBy      UserSearchHistory[]  @relation("searched")
  notifications   Notification[]       @relation("recipient")
  actedNotifs     Notification[]       @relation("actor")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model Location {
  id        Int      @id @default(autoincrement())
  city      String
  state     String
  zipCode   String
  country   String
  createdAt DateTime @default(now())
}

model Post {
  id           Int      @id @default(autoincrement())
  userId       String
  title        String?  @db.VarChar(200)
  content      String?  @db.VarChar(2200)
  isReel       Boolean  @default(false)
  likeCount    Int      @default(0)
  commentCount Int      @default(0)
  viewCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  images        PostImage[]
  likes         PostLike[]
  views         PostView[]
  comments      PostComment[]
  favorites     PostFavorite[]
  hashtags      PostHashtag[]
  stories       Story[]
  sharedIn      Message[]
  notifications Notification[]

  @@index([userId, createdAt])
  @@index([isReel, createdAt])
}

model PostImage {
  id       Int    @id @default(autoincrement())
  postId   Int
  fileName String
  order    Int
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model PostLike {
  userId    String
  postId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
}

model PostView {
  userId    String
  postId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model PostComment {
  id            Int            @id @default(autoincrement())
  postId        Int
  userId        String
  parentId      Int? // javob ba comment (1 sath, Spec 13 §3)
  comment       String         @db.VarChar(2200)
  replyCount    Int            @default(0)
  createdAt     DateTime       @default(now())
  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent        PostComment?   @relation("replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       PostComment[]  @relation("replies")
  notifications Notification[]

  @@index([postId, createdAt])
  @@index([parentId])
}

model PostFavorite {
  userId    String
  postId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model Hashtag {
  id    Int           @id @default(autoincrement())
  name  String        @unique // lowercase, bidun '#'
  posts PostHashtag[]
}

model PostHashtag {
  postId    Int
  hashtagId Int
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([postId, hashtagId])
  @@index([hashtagId])
}

model Story {
  id        Int      @id @default(autoincrement())
  userId    String
  fileName  String?
  postId    Int?
  createdAt DateTime @default(now())
  expiresAt DateTime // createdAt + 24 soat
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)

  views StoryView[]
  likes StoryLike[]

  @@index([userId, expiresAt])
}

model StoryView {
  id        Int      @id @default(autoincrement())
  storyId   Int
  viewerId  String
  createdAt DateTime @default(now())
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer    User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
}

model StoryLike {
  storyId   Int
  userId    String
  createdAt DateTime @default(now())
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([storyId, userId])
}

model Chat {
  id                Int       @id @default(autoincrement())
  sendUserId        String
  receiveUserId     String
  // jufti tartibdor (min, max) — baroi yak chat bayni du user
  pairKey           String    @unique
  // "Seen" va unread (Spec 13 §4)
  sendUserReadAt    DateTime?
  receiveUserReadAt DateTime?
  createdAt         DateTime  @default(now())
  lastMessageAt     DateTime  @default(now())
  sendUser          User      @relation("sendUser", fields: [sendUserId], references: [id], onDelete: Cascade)
  receiveUser       User      @relation("receiveUser", fields: [receiveUserId], references: [id], onDelete: Cascade)
  messages          Message[]

  @@index([sendUserId])
  @@index([receiveUserId])
}

model Message {
  id           Int      @id @default(autoincrement())
  chatId       Int
  userId       String
  messageText  String?  @db.VarChar(1000)
  file         String?
  sharedPostId Int? // share post ba Direct (Spec 13 §4)
  createdAt    DateTime @default(now())
  chat         Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sharedPost   Post?    @relation(fields: [sharedPostId], references: [id], onDelete: SetNull)

  @@index([chatId, createdAt])
}

model SearchHistory {
  id        Int      @id @default(autoincrement())
  userId    String
  text      String   @db.VarChar(100)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserSearchHistory {
  id           Int      @id @default(autoincrement())
  userId       String
  userSearchId String
  createdAt    DateTime @default(now())
  user         User     @relation("searcher", fields: [userId], references: [id], onDelete: Cascade)
  userSearch   User     @relation("searched", fields: [userSearchId], references: [id], onDelete: Cascade)

  @@unique([userId, userSearchId])
  @@index([userId, createdAt])
}

enum NotificationType {
  LIKE
  COMMENT
  COMMENT_REPLY
  FOLLOW
}

/// Spec 13 §1
model Notification {
  id          Int              @id @default(autoincrement())
  // Kalidi yakxela: LIKE:<actor>:<post>, FOLLOW:<actor>:<recipient>, COMMENT:<commentId> — takror nest
  key         String           @unique
  type        NotificationType
  recipientId String
  actorId     String
  postId      Int?
  commentId   Int?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  recipient   User             @relation("recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User             @relation("actor", fields: [actorId], references: [id], onDelete: Cascade)
  post        Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment     PostComment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
}
